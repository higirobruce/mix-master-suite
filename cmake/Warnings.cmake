# Warnings-as-errors for our own source files only. JUCE module sources are compiled into the same targets
# (console apps, plugins, tests), so the flags are applied per source file, restricted to files under this
# repository (and excluding the build tree), at the end of the top-level configure when all sources are known.
function(_mm_apply_warnings target)
    get_target_property(srcs ${target} SOURCES)
    if(NOT srcs)
        return()
    endif()
    if(MSVC)
        set(flags /W4 /WX /permissive- /utf-8)
    else()
        set(flags -Wall -Wextra -Wpedantic -Wconversion -Wshadow -Werror -Wno-unused-parameter)
    endif()
    set(ours)
    foreach(src IN LISTS srcs)
        if(NOT IS_ABSOLUTE "${src}")
            get_target_property(sdir ${target} SOURCE_DIR)
            set(src "${sdir}/${src}")
        endif()
        string(FIND "${src}" "${CMAKE_SOURCE_DIR}/" pos)
        string(FIND "${src}" "${CMAKE_BINARY_DIR}/" bpos)
        if(pos EQUAL 0 AND NOT bpos EQUAL 0 AND NOT src MATCHES "/_deps/|/\\.cache/")
            list(APPEND ours "${src}")
        endif()
    endforeach()
    if(ours)
        set_source_files_properties(${ours} TARGET_DIRECTORY ${target} PROPERTIES COMPILE_OPTIONS "${flags}")
    endif()
endfunction()

function(_mm_apply_all_warnings)
    get_property(targets GLOBAL PROPERTY MM_WARNING_TARGETS)
    foreach(t IN LISTS targets)
        _mm_apply_warnings(${t})
    endforeach()
endfunction()

function(mm_set_warnings target)
    get_target_property(type ${target} TYPE)
    if(type STREQUAL "INTERFACE_LIBRARY")
        return()
    endif()
    set_property(GLOBAL APPEND PROPERTY MM_WARNING_TARGETS ${target})
    get_property(armed GLOBAL PROPERTY MM_WARNINGS_DEFERRED)
    if(NOT armed)
        set_property(GLOBAL PROPERTY MM_WARNINGS_DEFERRED TRUE)
        cmake_language(DEFER DIRECTORY ${CMAKE_SOURCE_DIR} CALL _mm_apply_all_warnings)
    endif()
endfunction()
