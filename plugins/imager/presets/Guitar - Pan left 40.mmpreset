<?xml version="1.0" encoding="UTF-8"?>
<PRESET name="Guitar · Pan left 40" plugin="imager" version="1" meta="{&quot;tags&quot;: [&quot;stereo&quot;, &quot;instrument&quot;, &quot;pan&quot;], &quot;author&quot;: &quot;MixMaster&quot;, &quot;notes&quot;: &quot;Constant-power pan 40 % left, widths untouched.&quot;}">
  <PARAMS>
    <PARAM id="xover_low_hz" value="150"/>
    <PARAM id="xover_high_hz" value="3000"/>
    <PARAM id="width_low_pct" value="100"/>
    <PARAM id="width_mid_pct" value="100"/>
    <PARAM id="width_high_pct" value="100"/>
    <PARAM id="pan" value="-40"/>
    <PARAM id="mono_below_hz" value="0"/>
    <PARAM id="output_db" value="0"/>
    <PARAM id="bypass" value="0"/>
    <PARAM id="trim_db" value="0"/>
  </PARAMS>
</PRESET>
