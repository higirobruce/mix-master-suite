<?xml version="1.0" encoding="UTF-8"?>
<PRESET name="Pad · Super wide" plugin="imager" version="1" meta="{&quot;tags&quot;: [&quot;stereo&quot;, &quot;synth&quot;], &quot;author&quot;: &quot;MixMaster&quot;, &quot;notes&quot;: &quot;Mids and highs to 180 %: a pad pushed to the edges; low band kept at 100 %.&quot;}">
  <PARAMS>
    <PARAM id="xover_low_hz" value="250"/>
    <PARAM id="xover_high_hz" value="3000"/>
    <PARAM id="width_low_pct" value="100"/>
    <PARAM id="width_mid_pct" value="180"/>
    <PARAM id="width_high_pct" value="180"/>
    <PARAM id="pan" value="0"/>
    <PARAM id="mono_below_hz" value="0"/>
    <PARAM id="output_db" value="0"/>
    <PARAM id="bypass" value="0"/>
    <PARAM id="trim_db" value="0"/>
  </PARAMS>
</PRESET>
