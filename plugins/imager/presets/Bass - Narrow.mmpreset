<?xml version="1.0" encoding="UTF-8"?>
<PRESET name="Bass · Narrow" plugin="imager" version="1" meta="{&quot;tags&quot;: [&quot;stereo&quot;, &quot;bass&quot;], &quot;author&quot;: &quot;MixMaster&quot;, &quot;notes&quot;: &quot;Low band to 0 %, low-mids to 60 %: a centred bass with its harmonics still breathing.&quot;}">
  <PARAMS>
    <PARAM id="xover_low_hz" value="120"/>
    <PARAM id="xover_high_hz" value="800"/>
    <PARAM id="width_low_pct" value="0"/>
    <PARAM id="width_mid_pct" value="60"/>
    <PARAM id="width_high_pct" value="100"/>
    <PARAM id="pan" value="0"/>
    <PARAM id="mono_below_hz" value="0"/>
    <PARAM id="output_db" value="0"/>
    <PARAM id="bypass" value="0"/>
    <PARAM id="trim_db" value="0"/>
  </PARAMS>
</PRESET>
