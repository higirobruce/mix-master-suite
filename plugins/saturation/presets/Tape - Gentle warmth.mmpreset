<?xml version="1.0" encoding="UTF-8"?>
<PRESET name="Tape · Gentle warmth" plugin="saturation" version="1" meta="{&quot;tags&quot;:[&quot;colour&quot;,&quot;tape&quot;,&quot;bus&quot;],&quot;author&quot;:&quot;MixMaster&quot;,&quot;notes&quot;:&quot;Tape at reference drive: head bump and a touch of HF compression.&quot;}">
