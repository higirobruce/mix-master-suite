<?xml version="1.0" encoding="UTF-8"?>
<PRESET name="Tube · Vocal glow" plugin="saturation" version="1" meta="{&quot;tags&quot;:[&quot;colour&quot;,&quot;tube&quot;,&quot;vocal&quot;],&quot;author&quot;:&quot;MixMaster&quot;,&quot;notes&quot;:&quot;Tube with positive bias for even-order glow.&quot;}">
  <PARAMS>
    <PARAM id="drive_db" value="9"/>
