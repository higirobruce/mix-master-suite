<PRESET name="Tape · Hot vocal" plugin="saturation" version="1" meta="{&quot;tags&quot;:[&quot;colour&quot;,&quot;tape&quot;,&quot;vocal&quot;],&quot;author&quot;:&quot;MixMaster&quot;,&quot;notes&quot;:&quot;Tape driven 12 dB with the HF roll-off at 10 kHz.&quot;}">
