<?xml version="1.0" encoding="UTF-8"?>
<PRESET name="Console · Mix glue" plugin="saturation" version="1" meta="{&quot;tags&quot;:[&quot;colour&quot;,&quot;console&quot;,&quot;bus&quot;],&quot;author&quot;:&quot;MixMaster&quot;,&quot;notes&quot;:&quot;Tape at minimum drive with a small bias: console-style colour.&quot;}">
  <PARAMS>
    <PARAM id="drive_db" value="0"/>
    <PARAM id="character" value="0"/>
    <PARAM id="bias" value="0.1"/>
    <PARAM id="hf_rolloff_hz" value="20000"/>
    <PARAM id="mix_pct" value="100"/>
    <PARAM id="output_db" value="0"/>
    <PARAM id="bypass" value="0"/>
    <PARAM id="trim_db" value="0"/>
  </PARAMS>
</PRESET>
