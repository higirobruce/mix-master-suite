<?xml version="1.0" encoding="UTF-8"?>
<PRESET name="Tube · Bass thickener" plugin="saturation" version="1" meta="{&quot;tags&quot;:[&quot;colour&quot;,&quot;tube&quot;,&quot;bass&quot;],&quot;author&quot;:&quot;MixMaster&quot;,&quot;notes&quot;:&quot;Tube, moderate drive, parallel at 60 %.&quot;}">
  <PARAMS>
    <PARAM id="drive_db" value="12"/>
    <PARAM id="character" value="1"/>
    <PARAM id="bias" value="0.25"/>
    <PARAM id="hf_rolloff_hz" value="20000"/>
    <PARAM id="mix_pct" value="60"/>
    <PARAM id="output_db" value="0"/>
    <PARAM id="bypass" value="0"/>
    <PARAM id="trim_db" value="0"/>
  </PARAMS>
</PRESET>
