<?xml version="1.0" encoding="UTF-8"?>
<PRESET name="Mix bus - Gentle 2:1" plugin="bus_comp" version="1" meta="{&quot;tags&quot;: [&quot;mastering&quot;, &quot;bus&quot;, &quot;gentle&quot;], &quot;author&quot;: &quot;MixMaster&quot;, &quot;notes&quot;: &quot;2:1, 30 ms, 0.3 s.&quot;}">
  <PARAMS>
    <PARAM id="threshold_db" value="-6"/>
