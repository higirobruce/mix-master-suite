<?xml version="1.0" encoding="UTF-8"?>
<PRESET name="Mix bus - Slow and wide" plugin="bus_comp" version="1" meta="{&quot;tags&quot;: [&quot;mastering&quot;, &quot;bus&quot;, &quot;slow&quot;], &quot;author&quot;: &quot;MixMaster&quot;, &quot;notes&quot;: &quot;2:1, 30 ms, 1.2 s, sidechain HP 90 Hz.&quot;}">
  <PARAMS>
    <PARAM id="threshold_db" value="-10"/>
    <PARAM id="ratio" value="0"/>
    <PARAM id="attack" value="5"/>
    <PARAM id="release" value="3"/>
    <PARAM id="makeup_db" value="0"/>
    <PARAM id="mix_pct" value="100"/>
    <PARAM id="sc_hp_hz" value="90"/>
    <PARAM id="oversample" value="0"/>
    <PARAM id="sc_external" value="0"/>
    <PARAM id="bypass" value="0"/>
    <PARAM id="trim_db" value="0"/>
  </PARAMS>
</PRESET>
