<?xml version="1.0" encoding="UTF-8"?>
<PRESET name="Mix bus - Punch" plugin="bus_comp" version="1" meta="{&quot;tags&quot;: [&quot;mastering&quot;, &quot;bus&quot;, &quot;punch&quot;], &quot;author&quot;: &quot;MixMaster&quot;, &quot;notes&quot;: &quot;4:1, 30 ms attack lets transients through, 0.1 s release.&quot;}">
  <PARAMS>
    <PARAM id="threshold_db" value="-12"/>
    <PARAM id="ratio" value="1"/>
    <PARAM id="attack" value="5"/>
    <PARAM id="release" value="0"/>
    <PARAM id="makeup_db" value="2"/>
    <PARAM id="mix_pct" value="100"/>
    <PARAM id="sc_hp_hz" value="0"/>
    <PARAM id="oversample" value="0"/>
    <PARAM id="sc_external" value="0"/>
    <PARAM id="bypass" value="0"/>
    <PARAM id="trim_db" value="0"/>
  </PARAMS>
</PRESET>
