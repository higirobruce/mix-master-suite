<?xml version="1.0" encoding="UTF-8"?>
<PRESET name="Self-oscillate" plugin="delay" version="1" meta="{&quot;tags&quot;:[&quot;time_space&quot;,&quot;fx&quot;],&quot;author&quot;:&quot;MixMaster&quot;,&quot;notes&quot;:&quot;120 % feedback into the soft limiter: endless tail for effects.&quot;}">
  <PARAMS>
    <PARAM id="time_l_ms" value="250"/>
    <PARAM id="time_r_ms" value="250"/>
    <PARAM id="link_lr" value="1"/>
    <PARAM id="sync" value="0"/>
    <PARAM id="sync_r" value="0"/>
    <PARAM id="feedback_pct" value="120"/>
    <PARAM id="ping_pong" value="0"/>
    <PARAM id="fb_lp_hz" value="3000"/>
    <PARAM id="fb_hp_hz" value="100"/>
    <PARAM id="mod_depth_ms" value="0"/>
    <PARAM id="mod_rate_hz" value="0.5"/>
    <PARAM id="mix_pct" value="50"/>
    <PARAM id="duck_amount_db" value="0"/>
    <PARAM id="duck_release_ms" value="300"/>
    <PARAM id="bypass" value="0"/>
    <PARAM id="trim_db" value="0"/>
  </PARAMS>
</PRESET>
