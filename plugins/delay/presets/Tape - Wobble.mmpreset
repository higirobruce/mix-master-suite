<?xml version="1.0" encoding="UTF-8"?>
<PRESET name="Tape · Wobble" plugin="delay" version="1" meta="{&quot;tags&quot;:[&quot;time_space&quot;,&quot;chorus&quot;],&quot;author&quot;:&quot;MixMaster&quot;,&quot;notes&quot;:&quot;Modulated short delay for a tape-like wobble.&quot;}">
  <PARAMS>
    <PARAM id="time_l_ms" value="180"/>
    <PARAM id="time_r_ms" value="220"/>
    <PARAM id="link_lr" value="0"/>
    <PARAM id="sync" value="0"/>
    <PARAM id="sync_r" value="0"/>
    <PARAM id="feedback_pct" value="25"/>
    <PARAM id="ping_pong" value="0"/>
    <PARAM id="fb_lp_hz" value="6000"/>
    <PARAM id="fb_hp_hz" value="100"/>
    <PARAM id="mod_depth_ms" value="3"/>
    <PARAM id="mod_rate_hz" value="0.8"/>
    <PARAM id="mix_pct" value="30"/>
    <PARAM id="duck_amount_db" value="0"/>
    <PARAM id="duck_release_ms" value="300"/>
    <PARAM id="bypass" value="0"/>
    <PARAM id="trim_db" value="0"/>
  </PARAMS>
</PRESET>
