<?xml version="1.0" encoding="UTF-8"?>
<PRESET name="Listen · What is removed" plugin="deesser" version="1" meta="{&quot;tags&quot;: [&quot;dynamics&quot;, &quot;utility&quot;], &quot;author&quot;: &quot;MixMaster&quot;, &quot;notes&quot;: &quot;The default band with Listen engaged: audition the sibilance alone, then switch Listen off.&quot;}">
  <PARAMS>
    <PARAM id="freq_hz" value="6000"/>
    <PARAM id="threshold_db" value="-30"/>
    <PARAM id="range_db" value="12"/>
    <PARAM id="mode" value="0"/>
    <PARAM id="width_oct" value="1"/>
    <PARAM id="listen" value="1"/>
    <PARAM id="lookahead_ms" value="1"/>
    <PARAM id="bypass" value="0"/>
    <PARAM id="trim_db" value="0"/>
  </PARAMS>
</PRESET>
