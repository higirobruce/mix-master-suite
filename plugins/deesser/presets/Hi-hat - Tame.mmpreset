<?xml version="1.0" encoding="UTF-8"?>
<PRESET name="Hi-hat · Tame" plugin="deesser" version="1" meta="{&quot;tags&quot;: [&quot;dynamics&quot;, &quot;drums&quot;], &quot;author&quot;: &quot;MixMaster&quot;, &quot;notes&quot;: &quot;Split mode above 7 kHz with 3 ms lookahead for the transient; tames a splashy hat on the overheads.&quot;}">
  <PARAMS>
    <PARAM id="freq_hz" value="7000"/>
    <PARAM id="threshold_db" value="-20"/>
    <PARAM id="range_db" value="8"/>
    <PARAM id="mode" value="1"/>
    <PARAM id="width_oct" value="1"/>
    <PARAM id="listen" value="0"/>
    <PARAM id="lookahead_ms" value="3"/>
    <PARAM id="bypass" value="0"/>
    <PARAM id="trim_db" value="0"/>
  </PARAMS>
</PRESET>
