<?xml version="1.0" encoding="UTF-8"?>
<PRESET name="Acoustic guitar · String noise" plugin="deesser" version="1" meta="{&quot;tags&quot;: [&quot;dynamics&quot;, &quot;instrument&quot;], &quot;author&quot;: &quot;MixMaster&quot;, &quot;notes&quot;: &quot;Narrow band at 9 kHz for finger and string squeak.&quot;}">
  <PARAMS>
    <PARAM id="freq_hz" value="9000"/>
    <PARAM id="threshold_db" value="-28"/>
    <PARAM id="range_db" value="10"/>
    <PARAM id="mode" value="0"/>
    <PARAM id="width_oct" value="0.5"/>
    <PARAM id="listen" value="0"/>
    <PARAM id="lookahead_ms" value="1"/>
    <PARAM id="bypass" value="0"/>
    <PARAM id="trim_db" value="0"/>
  </PARAMS>
</PRESET>
