<?xml version="1.0" encoding="UTF-8"?>
<PRESET name="Mix bus · Harshness guard" plugin="deesser" version="1" meta="{&quot;tags&quot;: [&quot;dynamics&quot;, &quot;bus&quot;, &quot;gentle&quot;], &quot;author&quot;: &quot;MixMaster&quot;, &quot;notes&quot;: &quot;Low range, wide band at 5 kHz, high threshold: only the harshest moments move.&quot;}">
  <PARAMS>
    <PARAM id="freq_hz" value="5000"/>
    <PARAM id="threshold_db" value="-12"/>
    <PARAM id="range_db" value="4"/>
    <PARAM id="mode" value="0"/>
    <PARAM id="width_oct" value="1.5"/>
    <PARAM id="listen" value="0"/>
    <PARAM id="lookahead_ms" value="1"/>
    <PARAM id="bypass" value="0"/>
    <PARAM id="trim_db" value="0"/>
  </PARAMS>
</PRESET>
