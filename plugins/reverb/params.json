{
  "plugin": { "id": "reverb", "name": "Reverb", "family": "time_space", "version": "0.1.0", "code": "Rvrb", "accent": "#3FBFB0" },
  "params": [
    { "id": "algorithm", "name": "Algorithm", "type": "choice", "choices": ["Room", "Hall", "Plate", "Chamber"], "default": 1 },
    { "id": "predelay_ms", "name": "Pre-delay", "type": "float", "unit": "ms", "min": 0, "max": 250, "default": 20, "skew": 0.5, "smoothing_ms": 0 },
    { "id": "decay_s", "name": "Decay", "type": "float", "unit": "s", "min": 0.1, "max": 20, "default": 2.0, "skew": 0.3, "smoothing_ms": 20 },
    { "id": "size_pct", "name": "Size", "type": "float", "unit": "%", "min": 10, "max": 100, "default": 60, "skew": 1.0, "smoothing_ms": 0 },
    { "id": "damping_pct", "name": "Damping", "type": "float", "unit": "%", "min": 0, "max": 100, "default": 40, "skew": 1.0, "smoothing_ms": 20 },
    { "id": "diffusion_pct", "name": "Diffusion", "type": "float", "unit": "%", "min": 0, "max": 100, "default": 70, "skew": 1.0, "smoothing_ms": 20 },
    { "id": "low_cut_hz", "name": "Low cut", "type": "float", "unit": "Hz", "min": 20, "max": 1000, "default": 80, "skew": 0.3, "smoothing_ms": 20, "group": "advanced" },
    { "id": "high_cut_hz", "name": "High cut", "type": "float", "unit": "Hz", "min": 1000, "max": 20000, "default": 12000, "skew": 0.3, "smoothing_ms": 20, "group": "advanced" },
    { "id": "early_late_pct", "name": "Early / late", "type": "float", "unit": "%", "min": 0, "max": 100, "default": 40, "skew": 1.0, "smoothing_ms": 20 },
    { "id": "mix_pct", "name": "Mix", "type": "float", "unit": "%", "min": 0, "max": 100, "default": 30, "skew": 1.0, "smoothing_ms": 20 },
    { "id": "width_pct", "name": "Width", "type": "float", "unit": "%", "min": 0, "max": 200, "default": 100, "skew": 1.0, "smoothing_ms": 20, "group": "advanced" }
  ]
}
