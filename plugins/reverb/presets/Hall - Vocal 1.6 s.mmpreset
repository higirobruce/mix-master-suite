<?xml version="1.0" encoding="UTF-8"?>
<PRESET name="Hall · Vocal 1.6 s" plugin="reverb" version="1" meta="{&quot;tags&quot;:[&quot;time_space&quot;,&quot;hall&quot;,&quot;vocal&quot;],&quot;author&quot;:&quot;MixMaster&quot;,&quot;notes&quot;:&quot;Hall with a 40 ms pre-delay to keep the voice forward.&quot;}">
  <PARAMS>
    <PARAM id="algorithm" value="1"/>
    <PARAM id="predelay_ms" value="40"/>
    <PARAM id="decay_s" value="1.6"/>
    <PARAM id="size_pct" value="60"/>
    <PARAM id="damping_pct" value="50"/>
    <PARAM id="diffusion_pct" value="70"/>
    <PARAM id="low_cut_hz" value="150"/>
    <PARAM id="high_cut_hz" value="12000"/>
    <PARAM id="early_late_pct" value="40"/>
    <PARAM id="mix_pct" value="30"/>
    <PARAM id="width_pct" value="100"/>
    <PARAM id="bypass" value="0"/>
    <PARAM id="trim_db" value="0"/>
  </PARAMS>
</PRESET>
