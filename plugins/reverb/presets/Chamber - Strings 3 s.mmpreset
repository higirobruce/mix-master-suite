<?xml version="1.0" encoding="UTF-8"?>
<PRESET name="Chamber · Strings 3 s" plugin="reverb" version="1" meta="{&quot;tags&quot;:[&quot;time_space&quot;,&quot;chamber&quot;],&quot;author&quot;:&quot;MixMaster&quot;,&quot;notes&quot;:&quot;Chamber, 3 s, soft top.&quot;}">
  <PARAMS>
    <PARAM id="algorithm" value="3"/>
    <PARAM id="predelay_ms" value="20"/>
    <PARAM id="decay_s" value="3.0"/>
    <PARAM id="size_pct" value="70"/>
    <PARAM id="damping_pct" value="60"/>
    <PARAM id="diffusion_pct" value="70"/>
    <PARAM id="low_cut_hz" value="80"/>
    <PARAM id="high_cut_hz" value="12000"/>
    <PARAM id="early_late_pct" value="40"/>
    <PARAM id="mix_pct" value="30"/>
    <PARAM id="width_pct" value="100"/>
    <PARAM id="bypass" value="0"/>
    <PARAM id="trim_db" value="0"/>
  </PARAMS>
</PRESET>
