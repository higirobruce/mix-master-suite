<?xml version="1.0" encoding="UTF-8"?>
<PRESET name="Surgical · Notch" plugin="channel_eq" version="1" meta="{&quot;tags&quot;:[&quot;eq&quot;,&quot;cleanup&quot;],&quot;author&quot;:&quot;MixMaster&quot;,&quot;notes&quot;:&quot;Two narrow notches to drop into a resonance (move the frequency).&quot;}">
  <PARAMS>
    <PARAM id="hp_enabled" value="0"/>
