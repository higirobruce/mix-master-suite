    <PARAM id="b1_freq_hz" value="120"/>
    <PARAM id="b1_gain_db" value="-12.0"/>
    <PARAM id="b1_q" value="8.0"/>
    <PARAM id="b2_enabled" value="1"/>
    <PARAM id="b2_type" value="0"/>
    <PARAM id="b2_freq_hz" value="2400"/>
    <PARAM id="b2_gain_db" value="-12.0"/>
    <PARAM id="b2_q" value="8.0"/>
    <PARAM id="b3_enabled" value="0"/>
    <PARAM id="b3_type" value="0"/>
    <PARAM id="b3_freq_hz" value="1000"/>
    <PARAM id="b3_gain_db" value="0"/>
    <PARAM id="b3_q" value="1.0"/>
    <PARAM id="b4_enabled" value="0"/>
    <PARAM id="b4_type" value="0"/>
    <PARAM id="b4_freq_hz" value="4000"/>
    <PARAM id="b4_gain_db" value="0"/>
    <PARAM id="b4_q" value="1.0"/>
    <PARAM id="b5_enabled" value="0"/>
    <PARAM id="b5_type" value="0"/>
    <PARAM id="b5_freq_hz" value="8000"/>
    <PARAM id="b5_gain_db" value="0"/>
