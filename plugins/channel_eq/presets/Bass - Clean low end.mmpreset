<?xml version="1.0" encoding="UTF-8"?>
<PRESET name="Bass · Clean low end" plugin="channel_eq" version="1" meta="{&quot;tags&quot;:[&quot;eq&quot;,&quot;bass&quot;],&quot;author&quot;:&quot;MixMaster&quot;,&quot;notes&quot;:&quot;Sub tidy with a 24 dB/oct HP at 35 Hz, +2 dB at 90 Hz, honk cut.&quot;}">
  <PARAMS>
    <PARAM id="hp_enabled" value="1"/>
    <PARAM id="hp_freq_hz" value="35"/>
    <PARAM id="hp_slope" value="3"/>
    <PARAM id="lp_enabled" value="1"/>
    <PARAM id="lp_freq_hz" value="8000"/>
    <PARAM id="lp_slope" value="1"/>
    <PARAM id="b1_enabled" value="1"/>
    <PARAM id="b1_type" value="1"/>
    <PARAM id="b1_freq_hz" value="90"/>
    <PARAM id="b1_gain_db" value="2.0"/>
    <PARAM id="b1_q" value="0.7"/>
    <PARAM id="b2_enabled" value="1"/>
    <PARAM id="b2_type" value="0"/>
    <PARAM id="b2_freq_hz" value="600"/>
    <PARAM id="b2_gain_db" value="-2.0"/>
    <PARAM id="b2_q" value="1.4"/>
    <PARAM id="b3_enabled" value="1"/>
    <PARAM id="b3_type" value="0"/>
    <PARAM id="b3_freq_hz" value="1500"/>
    <PARAM id="b3_gain_db" value="1.5"/>
    <PARAM id="b3_q" value="1.0"/>
    <PARAM id="b4_enabled" value="0"/>
    <PARAM id="b4_type" value="0"/>
    <PARAM id="b4_freq_hz" value="3000"/>
    <PARAM id="b4_gain_db" value="0"/>
    <PARAM id="b4_q" value="1.0"/>
    <PARAM id="b5_enabled" value="0"/>
    <PARAM id="b5_type" value="2"/>
    <PARAM id="b5_freq_hz" value="10000"/>
    <PARAM id="b5_gain_db" value="0"/>
    <PARAM id="b5_q" value="0.7"/>
    <PARAM id="q_mode" value="0"/>
    <PARAM id="oversample" value="0"/>
    <PARAM id="analyser" value="3"/>
    <PARAM id="bypass" value="0"/>
    <PARAM id="trim_db" value="0"/>
  </PARAMS>
</PRESET>
