<?xml version="1.0" encoding="UTF-8"?>
<PRESET name="Mix bus · Tilt bright" plugin="channel_eq" version="1" meta="{&quot;tags&quot;:[&quot;eq&quot;,&quot;bus&quot;],&quot;author&quot;:&quot;MixMaster&quot;,&quot;notes&quot;:&quot;Analog Q, -1 dB low shelf and +1 dB high shelf, 2x oversampling.&quot;}">
  <PARAMS>
    <PARAM id="hp_enabled" value="0"/>
    <PARAM id="hp_freq_hz" value="80"/>
    <PARAM id="hp_slope" value="3"/>
    <PARAM id="lp_enabled" value="0"/>
    <PARAM id="lp_freq_hz" value="12000"/>
    <PARAM id="lp_slope" value="1"/>
    <PARAM id="b1_enabled" value="1"/>
    <PARAM id="b1_type" value="1"/>
    <PARAM id="b1_freq_hz" value="200"/>
    <PARAM id="b1_gain_db" value="-1.0"/>
    <PARAM id="b1_q" value="0.7"/>
    <PARAM id="b2_enabled" value="0"/>
    <PARAM id="b2_type" value="0"/>
    <PARAM id="b2_freq_hz" value="1000"/>
    <PARAM id="b2_gain_db" value="0"/>
    <PARAM id="b2_q" value="1.0"/>
    <PARAM id="b3_enabled" value="0"/>
    <PARAM id="b3_type" value="0"/>
    <PARAM id="b3_freq_hz" value="3000"/>
    <PARAM id="b3_gain_db" value="0"/>
    <PARAM id="b3_q" value="1.0"/>
    <PARAM id="b4_enabled" value="0"/>
    <PARAM id="b4_type" value="0"/>
    <PARAM id="b4_freq_hz" value="6000"/>
    <PARAM id="b4_gain_db" value="0"/>
    <PARAM id="b4_q" value="1.0"/>
    <PARAM id="b5_enabled" value="1"/>
    <PARAM id="b5_type" value="2"/>
    <PARAM id="b5_freq_hz" value="5000"/>
    <PARAM id="b5_gain_db" value="1.0"/>
    <PARAM id="b5_q" value="0.7"/>
    <PARAM id="q_mode" value="1"/>
    <PARAM id="oversample" value="1"/>
    <PARAM id="analyser" value="3"/>
    <PARAM id="bypass" value="0"/>
    <PARAM id="trim_db" value="0"/>
  </PARAMS>
</PRESET>
