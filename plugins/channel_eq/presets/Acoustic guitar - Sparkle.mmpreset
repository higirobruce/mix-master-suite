<?xml version="1.0" encoding="UTF-8"?>
<PRESET name="Acoustic guitar · Sparkle" plugin="channel_eq" version="1" meta="{&quot;tags&quot;:[&quot;eq&quot;,&quot;guitar&quot;],&quot;author&quot;:&quot;MixMaster&quot;,&quot;notes&quot;:&quot;HP 80 Hz, boom cut at 180 Hz, +2 dB at 8 kHz shelf.&quot;}">
  <PARAMS>
    <PARAM id="hp_enabled" value="1"/>
