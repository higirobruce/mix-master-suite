<?xml version="1.0" encoding="UTF-8"?>
<PRESET name="Tom · Bleed" plugin="gate" version="1" meta="{&quot;tags&quot;:[&quot;dynamics&quot;,&quot;drums&quot;,&quot;toms&quot;],&quot;author&quot;:&quot;MixMaster&quot;,&quot;notes&quot;:&quot;Long hold and release keep the tom ring, HP removes kick bleed.&quot;}">
  <PARAMS>
    <PARAM id="threshold_db" value="-26"/>
    <PARAM id="range_db" value="-40"/>
    <PARAM id="attack_ms" value="0.5"/>
    <PARAM id="hold_ms" value="150"/>
    <PARAM id="release_ms" value="300"/>
    <PARAM id="mode" value="0"/>
    <PARAM id="ratio" value="4"/>
    <PARAM id="hysteresis_db" value="4"/>
    <PARAM id="lookahead_ms" value="0"/>
    <PARAM id="sc_hp_enabled" value="1"/>
    <PARAM id="sc_hp_hz" value="120"/>
    <PARAM id="sc_lp_enabled" value="0"/>
    <PARAM id="sc_lp_hz" value="8000"/>
    <PARAM id="ext_key" value="0"/>
    <PARAM id="listen_sc" value="0"/>
    <PARAM id="bypass" value="0"/>
    <PARAM id="trim_db" value="0"/>
  </PARAMS>
</PRESET>
