<?xml version="1.0" encoding="UTF-8"?>
<PRESET name="Guitar amp · Hum" plugin="gate" version="1" meta="{&quot;tags&quot;:[&quot;dynamics&quot;,&quot;guitar&quot;],&quot;author&quot;:&quot;MixMaster&quot;,&quot;notes&quot;:&quot;Fast gate for amp hum between phrases, 5 ms lookahead.&quot;}">
  <PARAMS>
    <PARAM id="threshold_db" value="-40"/>
    <PARAM id="range_db" value="-80"/>
    <PARAM id="attack_ms" value="0.5"/>
    <PARAM id="hold_ms" value="80"/>
    <PARAM id="release_ms" value="150"/>
    <PARAM id="mode" value="0"/>
    <PARAM id="ratio" value="4"/>
    <PARAM id="hysteresis_db" value="6"/>
    <PARAM id="lookahead_ms" value="5"/>
    <PARAM id="sc_hp_enabled" value="0"/>
    <PARAM id="sc_hp_hz" value="80"/>
    <PARAM id="sc_lp_enabled" value="0"/>
    <PARAM id="sc_lp_hz" value="8000"/>
    <PARAM id="ext_key" value="0"/>
    <PARAM id="listen_sc" value="0"/>
    <PARAM id="bypass" value="0"/>
    <PARAM id="trim_db" value="0"/>
  </PARAMS>
</PRESET>
