<?xml version="1.0" encoding="UTF-8"?>
<PRESET name="Vocal · Noise floor" plugin="gate" version="1" meta="{&quot;tags&quot;:[&quot;dynamics&quot;,&quot;vocal&quot;],&quot;author&quot;:&quot;MixMaster&quot;,&quot;notes&quot;:&quot;Expander 2:1 with a gentle range so the room never slams shut.&quot;}">
  <PARAMS>
    <PARAM id="threshold_db" value="-45"/>
    <PARAM id="range_db" value="-24"/>
    <PARAM id="attack_ms" value="2"/>
    <PARAM id="hold_ms" value="100"/>
    <PARAM id="release_ms" value="250"/>
    <PARAM id="mode" value="1"/>
    <PARAM id="ratio" value="2"/>
    <PARAM id="hysteresis_db" value="4"/>
    <PARAM id="lookahead_ms" value="0"/>
    <PARAM id="sc_hp_enabled" value="0"/>
    <PARAM id="sc_hp_hz" value="80"/>
    <PARAM id="sc_lp_enabled" value="0"/>
    <PARAM id="sc_lp_hz" value="8000"/>
    <PARAM id="ext_key" value="0"/>
    <PARAM id="listen_sc" value="0"/>
    <PARAM id="bypass" value="0"/>
    <PARAM id="trim_db" value="0"/>
  </PARAMS>
</PRESET>
