<?xml version="1.0" encoding="UTF-8"?>
<PRESET name="Hi-hat · Bleed" plugin="gate" version="1" meta="{&quot;tags&quot;:[&quot;dynamics&quot;,&quot;drums&quot;,&quot;hats&quot;],&quot;author&quot;:&quot;MixMaster&quot;,&quot;notes&quot;:&quot;HP at 2 kHz keys on the hat only; moderate range.&quot;}">
  <PARAMS>
    <PARAM id="threshold_db" value="-32"/>
    <PARAM id="range_db" value="-30"/>
    <PARAM id="attack_ms" value="0.1"/>
    <PARAM id="hold_ms" value="20"/>
    <PARAM id="release_ms" value="80"/>
    <PARAM id="mode" value="0"/>
    <PARAM id="ratio" value="4"/>
    <PARAM id="hysteresis_db" value="3"/>
    <PARAM id="lookahead_ms" value="0"/>
    <PARAM id="sc_hp_enabled" value="1"/>
    <PARAM id="sc_hp_hz" value="2000"/>
    <PARAM id="sc_lp_enabled" value="0"/>
    <PARAM id="sc_lp_hz" value="8000"/>
    <PARAM id="ext_key" value="0"/>
    <PARAM id="listen_sc" value="0"/>
    <PARAM id="bypass" value="0"/>
    <PARAM id="trim_db" value="0"/>
  </PARAMS>
</PRESET>
