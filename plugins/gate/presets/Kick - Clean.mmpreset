<?xml version="1.0" encoding="UTF-8"?>
<PRESET name="Kick · Clean" plugin="gate" version="1" meta="{&quot;tags&quot;:[&quot;dynamics&quot;,&quot;drums&quot;,&quot;kick&quot;],&quot;author&quot;:&quot;MixMaster&quot;,&quot;notes&quot;:&quot;Sidechain LP at 300 Hz keys only the thump; 1 ms lookahead.&quot;}">
  <PARAMS>
    <PARAM id="threshold_db" value="-28"/>
    <PARAM id="range_db" value="-80"/>
    <PARAM id="attack_ms" value="0.2"/>
    <PARAM id="hold_ms" value="60"/>
    <PARAM id="release_ms" value="120"/>
    <PARAM id="mode" value="0"/>
    <PARAM id="ratio" value="4"/>
    <PARAM id="hysteresis_db" value="3"/>
    <PARAM id="lookahead_ms" value="1"/>
    <PARAM id="sc_hp_enabled" value="0"/>
    <PARAM id="sc_hp_hz" value="80"/>
    <PARAM id="sc_lp_enabled" value="1"/>
    <PARAM id="sc_lp_hz" value="300"/>
    <PARAM id="ext_key" value="0"/>
    <PARAM id="listen_sc" value="0"/>
    <PARAM id="bypass" value="0"/>
    <PARAM id="trim_db" value="0"/>
  </PARAMS>
</PRESET>
