{
  "plugin": {
    "id": "limiter",
    "name": "True-peak Limiter",
    "family": "mastering",
    "version": "0.1.0",
    "code": "Tplm",
    "accent": "#D8DDE4"
  },
  "params": [
    {
      "id": "input_db",
      "name": "Input",
      "type": "float",
      "unit": "dB",
