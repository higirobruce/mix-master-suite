<?xml version="1.0" encoding="UTF-8"?>
<PRESET name="Broadcast - R128 ceiling" plugin="limiter" version="1" meta="{&quot;tags&quot;: [&quot;mastering&quot;, &quot;limiter&quot;, &quot;broadcast&quot;], &quot;author&quot;: &quot;MixMaster&quot;, &quot;notes&quot;: &quot;Ceiling -1 dBTP, 10 ms lookahead, slow release.&quot;}">
  <PARAMS>
    <PARAM id="input_db" value="0"/>
    <PARAM id="ceiling_dbtp" value="-1.0"/>
    <PARAM id="release_ms" value="500.0"/>
    <PARAM id="auto_release" value="0"/>
    <PARAM id="lookahead_ms" value="10.0"/>
    <PARAM id="character" value="0"/>
    <PARAM id="link_pct" value="100"/>
    <PARAM id="dither" value="0"/>
    <PARAM id="bypass" value="0"/>
    <PARAM id="trim_db" value="0"/>
  </PARAMS>
</PRESET>
