<?xml version="1.0" encoding="UTF-8"?>
<PRESET name="Delivery - 24-bit dither" plugin="limiter" version="1" meta="{&quot;tags&quot;: [&quot;mastering&quot;, &quot;limiter&quot;, &quot;dither&quot;], &quot;author&quot;: &quot;MixMaster&quot;, &quot;notes&quot;: &quot;-1 dBTP with TPDF dither to 24 bits.&quot;}">
  <PARAMS>
    <PARAM id="input_db" value="0"/>
    <PARAM id="ceiling_dbtp" value="-1.0"/>
    <PARAM id="release_ms" value="100"/>
    <PARAM id="auto_release" value="1"/>
    <PARAM id="lookahead_ms" value="2"/>
    <PARAM id="character" value="0"/>
    <PARAM id="link_pct" value="100"/>
    <PARAM id="dither" value="2"/>
    <PARAM id="bypass" value="0"/>
    <PARAM id="trim_db" value="0"/>
  </PARAMS>
</PRESET>
