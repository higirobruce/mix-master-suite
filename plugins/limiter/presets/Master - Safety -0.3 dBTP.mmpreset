<?xml version="1.0" encoding="UTF-8"?>
<PRESET name="Master - Safety -0.3 dBTP" plugin="limiter" version="1" meta="{&quot;tags&quot;: [&quot;mastering&quot;, &quot;limiter&quot;, &quot;safety&quot;], &quot;author&quot;: &quot;MixMaster&quot;, &quot;notes&quot;: &quot;Ceiling -0.3 dBTP, 5 ms lookahead: catch overs only.&quot;}">
  <PARAMS>
    <PARAM id="input_db" value="0"/>
    <PARAM id="ceiling_dbtp" value="-0.3"/>
    <PARAM id="release_ms" value="100"/>
    <PARAM id="auto_release" value="1"/>
    <PARAM id="lookahead_ms" value="5.0"/>
    <PARAM id="character" value="0"/>
    <PARAM id="link_pct" value="100"/>
    <PARAM id="dither" value="0"/>
    <PARAM id="bypass" value="0"/>
    <PARAM id="trim_db" value="0"/>
  </PARAMS>
</PRESET>
