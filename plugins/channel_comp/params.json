    {
      "id": "topology",
      "name": "Topology",
      "type": "choice",
      "choices": [
        "Feed-forward",
        "Feedback"
      ],
      "default": 0,
      "group": "advanced"
    },
    {
      "id": "mix_pct",
      "name": "Mix",
      "type": "float",
      "unit": "%",
      "min": 0,
      "max": 100,
      "default": 100,
      "skew": 1.0,
      "smoothing_ms": 20
