      "min": -12,
      "max": 24,
      "default": 0,
      "skew": 1.0,
      "smoothing_ms": 20
    },
    {
      "id": "auto_makeup",
      "name": "Auto makeup",
      "type": "bool",
      "default": false
    },
    {
      "id": "stereo_link_pct",
      "name": "Stereo link",
      "type": "float",
      "unit": "%",
      "min": 0,
      "max": 100,
      "default": 100,
      "skew": 1.0,
      "smoothing_ms": 20,
