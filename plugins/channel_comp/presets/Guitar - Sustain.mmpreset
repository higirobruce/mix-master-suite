<?xml version="1.0" encoding="UTF-8"?>
<PRESET name="Guitar · Sustain" plugin="channel_comp" version="1" meta="{&quot;tags&quot;:[&quot;dynamics&quot;,&quot;guitar&quot;],&quot;author&quot;:&quot;MixMaster&quot;,&quot;notes&quot;:&quot;6:1 with a fast attack and long release for clean sustain.&quot;}">
  <PARAMS>
    <PARAM id="threshold_db" value="-28"/>
    <PARAM id="ratio" value="6"/>
    <PARAM id="ratio_inf" value="0"/>
    <PARAM id="attack_ms" value="2"/>
    <PARAM id="release_ms" value="400"/>
    <PARAM id="auto_release" value="0"/>
    <PARAM id="knee_db" value="4"/>
    <PARAM id="detector" value="0"/>
    <PARAM id="topology" value="0"/>
    <PARAM id="mix_pct" value="100"/>
    <PARAM id="sc_hp_enabled" value="0"/>
    <PARAM id="sc_hp_hz" value="90"/>
    <PARAM id="ext_key" value="0"/>
    <PARAM id="makeup_db" value="0"/>
    <PARAM id="auto_makeup" value="0"/>
    <PARAM id="stereo_link_pct" value="100"/>
    <PARAM id="listen_sc" value="0"/>
    <PARAM id="bypass" value="0"/>
    <PARAM id="trim_db" value="0"/>
  </PARAMS>
</PRESET>
