<?xml version="1.0" encoding="UTF-8"?>
<PRESET name="Drum bus · Smash" plugin="channel_comp" version="1" meta="{&quot;tags&quot;:[&quot;dynamics&quot;,&quot;drums&quot;,&quot;bus&quot;],&quot;author&quot;:&quot;MixMaster&quot;,&quot;notes&quot;:&quot;10:1, fast attack, 50 % mix for parallel crush, auto makeup.&quot;}">
  <PARAMS>
    <PARAM id="threshold_db" value="-24"/>
    <PARAM id="ratio" value="10"/>
    <PARAM id="ratio_inf" value="0"/>
    <PARAM id="attack_ms" value="1"/>
    <PARAM id="release_ms" value="100"/>
    <PARAM id="auto_release" value="0"/>
    <PARAM id="knee_db" value="0"/>
    <PARAM id="detector" value="0"/>
    <PARAM id="topology" value="0"/>
    <PARAM id="mix_pct" value="50"/>
    <PARAM id="sc_hp_enabled" value="0"/>
    <PARAM id="sc_hp_hz" value="90"/>
    <PARAM id="ext_key" value="0"/>
    <PARAM id="makeup_db" value="0"/>
    <PARAM id="auto_makeup" value="1"/>
    <PARAM id="stereo_link_pct" value="100"/>
    <PARAM id="listen_sc" value="0"/>
    <PARAM id="bypass" value="0"/>
    <PARAM id="trim_db" value="0"/>
  </PARAMS>
</PRESET>
