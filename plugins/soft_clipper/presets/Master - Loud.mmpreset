<?xml version="1.0" encoding="UTF-8"?>
<PRESET name="Master - Loud" plugin="soft_clipper" version="1" meta="{&quot;tags&quot;: [&quot;mastering&quot;, &quot;clipper&quot;, &quot;loud&quot;], &quot;author&quot;: &quot;MixMaster&quot;, &quot;notes&quot;: &quot;+4 dB in, ceiling -0.3, knee 20 %.&quot;}">
  <PARAMS>
    <PARAM id="input_db" value="4.0"/>
    <PARAM id="ceiling_db" value="-0.3"/>
    <PARAM id="knee_pct" value="20"/>
    <PARAM id="mix_pct" value="100"/>
    <PARAM id="listen_delta" value="0"/>
    <PARAM id="oversample" value="0"/>
    <PARAM id="true_peak" value="1"/>
    <PARAM id="bypass" value="0"/>
    <PARAM id="trim_db" value="0"/>
  </PARAMS>
</PRESET>
